DATABASE_URL=          # Neon Postgres connection string
DATABASE_HOSTADDRS=    # optional comma-separated IP fallbacks for local DNS outages
AUTH_SECRET=           # NextAuth secret (random string, run: openssl rand -base64 32)
AUTH_GITHUB_ID=        # GitHub OAuth app client ID
AUTH_GITHUB_SECRET=    # GitHub OAuth app client secret
NEXT_PUBLIC_SITE_URL=     # https://contrakt.dev
NEXT_PUBLIC_REGISTRY_URL= # https://registry.contrakt.dev (or http://localhost:3000)
NEXT_PUBLIC_APP_URL=      # legacy alias; prefer NEXT_PUBLIC_REGISTRY_URL

# Production protection and background delivery
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_WORKER_SECRET=    # openssl rand -base64 32

# Error monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# x402 payment verification network (optional)
X402_NETWORK=base-sepolia # Base Sepolia is the launch default
X402_RPC_URL=          # optional RPC override for the selected network
X402_USDC_ADDRESS=     # optional USDC token-address override
X402_CONFIRMATIONS=2
X402_ENABLE_MAINNET=false # must be explicitly true before Base mainnet can run in production
NEXT_PUBLIC_X402_NETWORK=base-sepolia
NEXT_PUBLIC_USDC_DEPOSIT_URL= # optional funding/bridge URL override

# Embedded wallets (Coinbase Developer Platform)
NEXT_PUBLIC_CDP_PROJECT_ID=   # CDP Portal project ID; allowlist your local and production origins

# Fiat-to-USDC funding (Onramper)
ONRAMPER_API_KEY=             # Onramper production public API key
ONRAMPER_SIGNING_SECRET=      # server-only widget URL signing secret
ONRAMPER_NETWORK_ID=base      # Onramper network id
